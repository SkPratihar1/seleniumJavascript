{
  "name": "selenium-javascript-framework",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "mocha --timeout 60000 'test/**/*.test.js'",
    "test:smoke": "mocha --timeout 60000 \"test/smoke/*.test.js\"",
    "test:regression": "mocha --timeout 60000 'test/regression/**/*.test.js'",
    "report": "mochawesome-merge ./reports/*.json -o ./reports/report.json",
    "test:single": "mocha --timeout 60000"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "chai": "^4.3.7",
    "dotenv": "^16.3.1",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.10.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1"
  }
}
